@model Maqalaty.Models.Article

@{
    ViewData["Title"] = "Delete Article";
}

<div class="container py-5">

    <div class="row justify-content-center">

        <div class="col-lg-8">

            <!-- Back Button -->
            <div class="mb-4">
                <a asp-controller="Articles"
                   asp-action="Index"
                   class="btn btn-outline-secondary">
                    ← Back to Articles
                </a>
            </div>

            <!-- Page Header -->
            <div class="mb-4">

                <span class="badge bg-danger-subtle text-danger px-3 py-2 mb-3">
                    Admin Dashboard
                </span>

                <h1 class="display-5 fw-bold mb-2">
                    Delete Article
                </h1>

                <p class="text-muted">
                    Review the article details before confirming deletion.
                </p>

            </div>

            <!-- Delete Confirmation Card -->
            <div class="card border-0 shadow-sm">

                <div class="card-body p-4 p-md-5">

                    <!-- Warning Message -->
                    <div class="alert alert-danger border-0 p-4 mb-4"
                         role="alert">

                        <h5 class="fw-bold mb-2">
                            ⚠️ Are you sure?
                        </h5>

                        <p class="mb-0">
                            You are about to permanently delete this article.
                            This action cannot be undone.
                        </p>

                    </div>

                    <!-- Article Information -->
                    <div class="p-4 rounded-3 mb-4"
                         style="background-color: #f8fafc; border: 1px solid #e2e8f0;">

                        <span class="badge bg-secondary-subtle text-secondary mb-3">
                            Article Information
                        </span>

                        <h3 class="fw-bold mb-3">
                            @Model.Title
                        </h3>

                        <div class="d-flex flex-wrap gap-3 text-muted">

                            <span>
                                ✍️ By @Model.Author
                            </span>

                            <span>
                                📅 @Model.CreatedAt.ToString("MMMM dd, yyyy")
                            </span>

                        </div>

                        <div class="mt-3">

                            @if (Model.IsPublished)
                            {
                                <span class="badge bg-success-subtle text-success">
                                    Published
                                </span>
                            }
                            else
                            {
                                <span class="badge bg-warning-subtle text-warning-emphasis">
                                    Draft
                                </span>
                            }

                        </div>

                    </div>

                    <hr class="my-4" />

                    <!-- Delete Form -->
                    <form asp-controller="Articles"
                          asp-action="Delete"
                          asp-route-id="@Model.Id"
                          method="post">

                        @Html.AntiForgeryToken()

                        <input type="hidden" asp-for="Id" />

                        <div class="d-flex flex-wrap gap-3">

                            <button type="submit"
                                    class="btn btn-danger px-4 py-2">
                                Yes, Delete Article
                            </button>

                            <a asp-controller="Articles"
                               asp-action="Index"
                               class="btn btn-outline-secondary px-4 py-2">
                                Cancel
                            </a>

                        </div>

                    </form>

                </div>

            </div>

        </div>

    </div>

</div>