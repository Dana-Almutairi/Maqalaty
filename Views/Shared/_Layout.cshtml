<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    <title>@ViewData["Title"] - Maqalaty</title>

    <script type="importmap"></script>

    <link rel="stylesheet"
          href="~/lib/bootstrap/dist/css/bootstrap.min.css" />

    <link rel="stylesheet"
          href="~/css/site.css"
          asp-append-version="true" />

    <link rel="stylesheet"
          href="~/css/maqalaty.css"
          asp-append-version="true" />

    <link rel="stylesheet"
          href="~/Maqalaty.styles.css"
          asp-append-version="true" />
</head>

<body class="d-flex flex-column min-vh-100">

    <!-- Navbar -->
    <header>

        <nav class="navbar navbar-expand-lg navbar-light bg-white shadow-sm">

            <div class="container">

                <!-- Brand -->
                <a class="navbar-brand fw-bold fs-3"
                   asp-controller="Articles"
                   asp-action="Index">

                    Maqalaty<span class="text-primary">.</span>

                </a>

                <!-- Mobile Menu Button -->
                <button class="navbar-toggler"
                        type="button"
                        data-bs-toggle="collapse"
                        data-bs-target="#mainNavbar"
                        aria-controls="mainNavbar"
                        aria-expanded="false"
                        aria-label="Toggle navigation">

                    <span class="navbar-toggler-icon"></span>

                </button>

                <!-- Navigation -->
                <div class="collapse navbar-collapse"
                     id="mainNavbar">

                    <ul class="navbar-nav mx-auto gap-lg-3">

                        <li class="nav-item">

                            <a class="nav-link"
                               asp-controller="Home"
                               asp-action="Index">
                                Home
                            </a>

                        </li>

                        <li class="nav-item">

                            <a class="nav-link"
                               asp-controller="Articles"
                               asp-action="Index">
                                Explore Articles
                            </a>

                        </li>

                        <li class="nav-item">

                            <a class="nav-link"
                               asp-controller="Home"
                               asp-action="Privacy">
                                Privacy
                            </a>

                        </li>

                    </ul>

                    <!-- Authentication -->
                    <div class="d-flex flex-column flex-lg-row align-items-lg-center gap-3 mt-3 mt-lg-0">

                        @if (User.Identity?.IsAuthenticated == true)
                        {
                            @if (User.IsInRole("Admin"))
                            {
                                <span class="badge bg-primary-subtle text-primary px-3 py-2">
                                    Admin
                                </span>
                            }

                            <form asp-controller="Account"
                                  asp-action="Logout"
                                  method="post"
                                  class="m-0">

                                @Html.AntiForgeryToken()

                                <button type="submit"
                                        class="btn btn-outline-secondary px-4">
                                    Logout
                                </button>

                            </form>
                        }
                        else
                        {
                            <a asp-controller="Account"
                               asp-action="Login"
                               class="btn btn-primary px-4">
                                Login
                            </a>
                        }

                    </div>

                </div>

            </div>

        </nav>

    </header>

    <!-- Main Content -->
    <main role="main" class="flex-grow-1">

        @RenderBody()

    </main>

    <!-- Footer -->
    <footer class="border-top bg-white py-4 mt-auto">

        <div class="container">

            <div class="row align-items-center gy-3">

                <div class="col-md-6 text-center text-md-start">

                    <a asp-controller="Articles"
                       asp-action="Index"
                       class="text-decoration-none fw-bold fs-5 text-dark">

                        Maqalaty<span class="text-primary">.</span>

                    </a>

                    <p class="text-muted small mb-0 mt-2">
                        A place for ideas, stories, and knowledge.
                    </p>

                </div>

                <div class="col-md-6">

                    <div class="d-flex justify-content-center justify-content-md-end gap-4">

                        <a asp-controller="Home"
                           asp-action="Index"
                           class="text-decoration-none text-muted small">
                            Home
                        </a>

                        <a asp-controller="Articles"
                           asp-action="Index"
                           class="text-decoration-none text-muted small">
                            Articles
                        </a>

                        <a asp-controller="Home"
                           asp-action="Privacy"
                           class="text-decoration-none text-muted small">
                            Privacy
                        </a>

                    </div>

                </div>

            </div>

            <hr class="my-4" />

            <div class="text-center text-muted small">

                &copy; @DateTime.UtcNow.Year Maqalaty.
                All rights reserved.

            </div>

        </div>

    </footer>

    <!-- Scripts -->
    <script src="~/lib/jquery/dist/jquery.min.js"></script>

    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>

    <script src="~/js/site.js"
            asp-append-version="true"></script>

    @await RenderSectionAsync("Scripts", required: false)

</body>

</html>